# Copy this file to `.env` and fill in the required values.
# Do NOT commit `.env` — it is ignored by git.

# --- Required for the add-movie / add-book CLI scripts ---
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# --- Build-time assets (optional; fallbacks exist in src/_data/site.json) ---
# Set SKIP_FETCH_ASSETS=1 to bypass remote asset fetching in CI/offline.
SKIP_FETCH_ASSETS=
PROFILE_IMAGE_URL=
OG_DEFAULT_URL=
RETRO_STARS_URL=

# --- Base URL (defaults to http://localhost:8080 in dev) ---
# URL=

# --- Include draft posts in builds (set to e.g. "true" to enable) ---
# BUILD_DRAFTS=
