{
  "name": "personal-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "My personal website",
  "author": "Bruno Pulis",
  "repository": {
    "type": "git",
    "url": "https://github.com/brunopulis/personal-site.git"
  },
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "clean": "rimraf _site",
    "clean:og": "rimraf src/assets/og-images",
    "dev": "run-p dev:*",
    "dev:css": "node scripts/build-css.js --watch",
    "dev:11ty": "cross-env ELEVENTY_ENV=development eleventy --serve",
    "start": "npm run dev:11ty",
    "dev:search": "npx pagefind --site _site --serve",
    "colors": "node ./src/_config/setup/create-colors.js",
    "build": "npm run clean && npm run build:11ty && npm run build:search",
    "build:11ty": "cross-env ELEVENTY_ENV=production eleventy",
    "build:search": "npx pagefind --site _site",
    "build:setup": "node scripts/build-setup.js",
    "build:css": "node scripts/build-css.js",
    "add-movie": "node scripts/add-movie.js",
    "add-book": "node scripts/add-book.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "test:e2e:ci": "start-server-and-test 'eleventy --serve --port=8080' http://localhost:8080 'cypress run'",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,json,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-plugin-rss": "^3.0.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "lite-youtube-embed": "^0.3.4"
  },
  "devDependencies": {
    "@11ty/eleventy-img": "^7.0.0",
    "@toycode/markdown-it-class": "^1.2.4",
    "@vitest/coverage-v8": "^5.0.0",
    "autoprefixer": "^10.5.5",
    "axe-core": "^4.13.0",
    "colorjs.io": "^0.7.1",
    "cross-env": "^10.1.0",
    "cssnano": "^9.0.5",
    "cypress": "^15.21.1",
    "cypress-axe": "^1.7.0",
    "dayjs": "^1.11.23",
    "dotenv": "^17.4.2",
    "html-minifier-terser": "^7.2.0",
    "husky": "^9.1.7",
    "js-yaml": "^5.4.1",
    "lint-staged": "^17.5.0",
    "luxon": "^3.7.2",
    "markdown-it": "^15.0.1",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-attrs": "^5.0.1",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-link-attributes": "^4.0.1",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-prism": "^4.0.0",
    "npm-run-all": "^4.1.5",
    "pagefind": "^1.5.2",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "sass": "^1.104.0",
    "sharp": "^0.35.4",
    "slugify": "^1.6.9",
    "start-server-and-test": "^3.0.12",
    "svgo": "^4.1.0",
    "vitest": "^5.0.0"
  }
}
