{% set metaDescription %}
  {%- if discover.description -%}
    {{- discover.description -}}
  {%- elif description -%}
    {{- description -}}
  {%- else -%}
    {{- meta.siteDescription -}}
  {%- endif -%}
{% endset %}

<meta name="description" content="{{ metaDescription }}" />

<!-- Search Engines -->
<meta name="robots" content="index,follow" />
<meta name="googlebot" content="index,follow" />
<!-- Made with Eleventy! -->
<meta name="generator" content="{{ eleventy.generator }}" />
<!-- Disable automatic detection and formatting of possible phone numbers -->
<meta name="format-detection" content="telephone=no" />
<!-- supports both dark and light color schemes, page author prefers light as default. -->
<meta name="color-scheme" content="light dark" />
<!-- Helps prevent duplicate content issues -->
<link rel="canonical" href="{{ meta.url }}{{ page.url }}" />

{% if meta.author.me and meta.author.me.length %}
  <!-- rel=me profiles -->
  {% for url in meta.author.me %}
    <link rel="me" href="{{ url }}" />
  {% endfor %}
{% endif %}

{% if meta.author.social and meta.author.social.mastodon %}
  <link rel="me" href="{{ meta.author.social.mastodon }}" />
{% endif %}
<link
  rel="site.standard.document"
  href="at://did:plc:jtwk3253wycggbzl3sr7b6gi/site.standard.document/rkey"
/>

{# Open Graph (Facebook, LinkedIn, etc.) #}
{% set ogTitle = title or meta.siteName %}
{% set ogDescription = description or meta.siteDescription %}
{% set ogUrl = (meta.url and (meta.url + (page.url or '/'))) or '' %}
{# Resolve image: per-page image, or generated OG for posts, or default #}
{% set rawImage = image %}
{% if not rawImage %}
  {% if page.url | startsWith('/blog/') %}
    {% set rawImage = '/assets/og-images/' + (title | slugify) + '-preview.jpeg' %}
  {% else %}
    {% set rawImage = '/assets/og-default.png' %}
  {% endif %}
{% endif %}
{% if meta.url %}
  {% if rawImage | startsWith('http') %}
    {% set ogImage = rawImage %}
  {% elseif rawImage | startsWith('/') %}
    {% set ogImage = meta.url + rawImage %}
  {% else %}
    {% set ogImage = meta.url + '/' + rawImage %}
  {% endif %}
{% else %}
  {% set ogImage = rawImage %}
{% endif %}
<meta property="og:type" content="website" />
<meta property="og:site_name" content="{{ meta.siteName }}" />
{% if ogUrl %}<meta property="og:url" content="{{ ogUrl }}" />{% endif %}
<meta property="og:title" content="{{ ogTitle }}" />
<meta property="og:description" content="{{ ogDescription }}" />
<meta property="og:image" content="{{ ogImage }}" />
<meta property="og:image:alt" content="{{ meta.siteName }} preview" />

<!-- Twitter specific head -->
<meta name="twitter:card" content="summary_large_image" />
{% if meta.author.social and meta.author.social.twitter %}
  <meta name="twitter:site" content="{{ meta.author.social.twitter }}" />
  <meta name="twitter:creator" content="{{ meta.author.social.twitter }}" />
{% endif %}
<meta name="twitter:title" content="{{ ogTitle }}" />
<meta name="twitter:description" content="{{ ogDescription }}" />
<meta name="twitter:image" content="{{ ogImage }}" />
<meta name="twitter:image:alt" content="{{ meta.siteName }} preview" />
<link rel="webmention" href="https://webmention.io/{{ meta.url | replace('https://', '') | replace('http://', '') }}/webmention" />
<link rel="pingback" href="https://webmention.io/{{ meta.url | replace('https://', '') | replace('http://', '') }}/xmlrpc" />

<!-- RSS Autodiscovery. Loops over meta.blog.feedLinks -->
<link rel="alternate" href="{{ meta.url }}/feeds/all/rss.xml" title="Todo o conteúdo - Bruno Pulis" type="application/rss+xml">
<link rel="alternate" href="{{ meta.url }}/feeds/blog/rss.xml" title="Artigos do Blog - Bruno Pulis" type="application/rss+xml">
<link rel="alternate" href="{{ meta.url }}/feeds/notes/rss.xml" title="Notas - Bruno Pulis" type="application/rss+xml">
<link rel="alternate" href="{{ meta.url }}/feeds/books/rss.xml" title="Minha biblioteca de livros - Bruno Pulis" type="application/rss+xml">
<link rel="alternate" href="{{ meta.url }}/feeds/shows/rss.xml" title="Meus seriados - Bruno Pulis" type="application/rss+xml">

{# Favicon and theme color #}
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
<link rel="shortcut icon" href="/assets/favicon.svg" type="image/svg+xml">
<link rel="mask-icon" href="/assets/favicon.svg" color="#171e1e">
<link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon-16x16.png">
<link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png">
<meta name="theme-color" content="#d9d9d9" />
