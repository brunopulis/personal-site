<section id="webmentions" class="region" style="--region-space: var(--space-xl)">
  <div class="flow" style="--flow-space: var(--space-xs)">
    <h2>
      Respostas via <em>webmention's</em>
    </h2>
    <div id="webmentions-list">
      <p>Carregando <em lang="en">webmentions</em>...</p>
    </div>
  </div>
</section>

{% if webmentions and webmentions.length > 0 %}
  <div class="flow" style="--flow-space: var(--space-s)">
    {% for mention in webmentions %}
      <article class="callout flow">
        <div class="cluster" style="--gutter: var(--space-xs); --cluster-vertical-alignment: flex-start;">
          {% if mention.author.photo %}
            <img
              class="avatar"
              src="{{ mention.author.photo }}"
              alt="{{ mention.author.name }}"
              loading="lazy"
            />
          {% else %}
            <div class="avatar center" style="background-color: var(--color-surface-raised);">
              <span class="meta">
                {{ mention.author.name | first }}
              </span>
            </div>
          {% endif %}
          <div style="flex: 1 1 16rem; min-width: 0;">
            <div class="cluster" style="--gutter: var(--space-2xs)">
              <a
                href="{{ mention.author.url }}"
                target="_blank"
                rel="noopener"
              >
                {{ mention.author.name }}
              </a>
              <span>
                {% if mention['wm-property'] == 'like-of' %}
                  gostei disso
                {% elif mention['wm-property'] == 'repost-of' %}
                  repostei isso
                {% elif mention['wm-property'] == 'bookmark-of' %}
                  favoritei isso
                {% elif mention['wm-property'] == 'mention-of' %}
                  mencionei isso
                {% else %}
                  respondi
                {% endif %}
              </span>
              <time class="meta" datetime="{{ mention.published }}">
                {{ mention.published | readableDate }}
              </time>
            </div>
            {% if mention.content and mention.content.text %}
              <p>
                {{ mention.content.text | truncate(280) }}
              </p>
            {% endif %}
            <a
              href="{{ mention.url }}"
              target="_blank"
              rel="noopener"
            >
              Ver o original
            </a>
          </div>
        </div>
      </article>
    {% endfor %}
  </div>
{% else %}
  <div class="region flow" style="--region-space: var(--space-l)">
    <p>Ainda não há menções via webmention. Seja o primeiro a responder!</p>
    <p>
      <a
        href="https://indieweb.org/Webmention"
        target="_blank"
        rel="noopener noreferrer"
      >
        Aprenda sobre <em>webmentions</em>
      </a>
    </p>
  </div>
{% endif %}
