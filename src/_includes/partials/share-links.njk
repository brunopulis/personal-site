<section class="region" style="--region-space: var(--space-m)">
  <hr>
  <div class="flow" style="--flow-space: var(--space-xs)">
    <p class="meta uppercase">Compartilhe</p>
    <ul class="cluster" role="list" style="--gutter: var(--space-s)">
      <li>
        <a href="mailto:{{site.email}}?subject=Resposta para {{title}}">
          Responder via e-mail
        </a>
      </li>
      <li>
        <a
          href="https://twitter.com/intent/tweet?url={{ site.url }}{{ page.url }}&text={{ title | urlencode }}"
          target="_blank"
          rel="noopener noreferrer"
          class="u-syndication"
        >
          Twitter
        </a>
      </li>
      <li>
        <a class="u-syndication"
           href="https://mastodon.social/share?text={{ title | urlencode }}%20{{ site.url }}{{ page.url }}"
           target="_blank"
           rel="noopener noreferrer">
          Mastodon
        </a>
      </li>
      <li>
        <a
          href="https://bsky.app/intent/compose?text={{ title | urlencode }}%20{{ site.url }}{{ page.url }}"
          target="_blank"
          rel="noopener noreferrer"
          class="u-syndication"
        >
          Bluesky
        </a>
      </li>
      <li>
        <a
          href="https://www.linkedin.com/sharing/share-offsite/?url={{ site.url }}{{ page.url }}"
          target="_blank"
          rel="noopener"
          class="u-syndication"
        >
          LinkedIn
        </a>
      </li>
    </ul>
  </div>
</section>
