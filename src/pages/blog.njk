---
layout: base
permalink: '/blog/index.html'
title: Blog
---

<div class="h-feed flow">
  <header class="blog-header">
    <h1 class="p-name blog-title">Blog</h1>
    <a class="visually-hidden u-url" href="{{ meta.url }}/blog/" aria-label="Blog"></a>
    <p class="blog-lede">
      Artigos e conteúdos longos sobre acessibilidade, desenvolvimento web e a vida por trás da tela.
    </p>
    <p class="blog-count">{{ collections.posts | length }} artigos publicados</p>

    <div class="callout flow blog-rss">
      <p class="cluster" style="--gutter: var(--space-2xs)">
        {% faIcon 'rss', 'solid', 24 %}
        <a href="/feeds/blog/rss.xml">
          Assine o meu feed do blog.
        </a>
      </p>
    </div>
  </header>

  {% set featuredPosts = collections.posts | featuredPosts %}
  {% set yearGroups = collections.posts | nonFeaturedPosts | archiveByYear %}

  <nav class="cluster blog-subnav" style="--gutter: var(--space-s-m)" aria-label="Navegação do arquivo">
    <span class="blog-subnav-current" aria-current="true">Todas as postagens</span>
    <a href="/blog/categorias/">Categorias</a>
    <a href="/tags/">Tags</a>
  </nav>

  {% if featuredPosts | length > 0 %}
    <section class="blog-featured" aria-labelledby="blog-featured-title">
      <h2 class="blog-featured-title" id="blog-featured-title">Em destaque</h2>
      {% for post in featuredPosts %}
        {% set dateVal = post.date %}
        {% set url = post.url or post.id %}
        {% set title = (post.data and post.data.title) or post.title %}
        {% set description = (post.data and post.data.description) or post.description or (post.templateContent | default('') | striptags | truncate(160)) %}
        {% set tags = (post.data and post.data.tags) or post.tags or [] %}
        <article class="blog__post h-entry">
          <p class="home-post-meta">
            {% if dateVal %}
              <time class="dt-published" datetime="{{ dateVal | htmlDateString }}">
                {{ dateVal | readableDate }}
              </time>
            {% endif %}

            {% if tags %}
              {% for tag in tags %}
                <a class="p-category" href="/tags/{{ tag | slug }}/">#{{ tag }}</a>
              {% endfor %}
            {% endif %}
          </p>

          <h3 class="home-post-title p-name">
            <a class="u-url" href="{{ url }}">{{ title }}</a>
          </h3>

          {% if description %}
            <p class="home-post-summary p-summary">{{ description }}</p>
          {% endif %}
        </article>
      {% endfor %}
    </section>
  {% endif %}

  <p class="blog-count blog-archive-count">
    Arquivo completo: {{ collections.posts | length }} artigos publicados desde {{ (yearGroups | last).year }}.
  </p>

  <nav class="blog-jump" aria-labelledby="blog-jump-label">
    <span class="meta blog-jump-label" id="blog-jump-label">Navegar por ano</span>
    <ol class="cluster blog-jump-list" role="list" style="--gutter: var(--space-s-m)">
      {% for yearGroup in yearGroups %}
        <li>
          <a href="#year-{{ yearGroup.year }}">{{ yearGroup.year }}</a>
        </li>
      {% endfor %}
    </ol>
  </nav>

  {% for yearGroup in yearGroups %}
    <div
      class="blog-year"
      id="year-{{ yearGroup.year }}"
      aria-labelledby="year-{{ yearGroup.year }}-title">
      <h2 class="blog-year-title" id="year-{{ yearGroup.year }}-title">{{ yearGroup.year }}</h2>
      {% for post in yearGroup.items %}
        {% set dateVal = post.date %}
        {% set url = post.url or post.id %}
        {% set title = (post.data and post.data.title) or post.title %}
        {% set description = (post.data and post.data.description) or post.description or (post.templateContent | default('') | striptags | truncate(160)) %}
        {% set tags = (post.data and post.data.tags) or post.tags or [] %}
        <article class="blog__post h-entry">
          <p class="home-post-meta">
            {% if dateVal %}
              <time class="dt-published" datetime="{{ dateVal | htmlDateString }}">
                {{ dateVal | readableDate }}
              </time>
            {% endif %}

            {% if tags %}
              {% for tag in tags %}
                <a class="p-category" href="/tags/{{ tag | slug }}/">#{{ tag }}</a>
              {% endfor %}
            {% endif %}
          </p>

          <h3 class="home-post-title p-name">
            <a class="u-url" href="{{ url }}">{{ title }}</a>
          </h3>

          {% if description %}
            <p class="home-post-summary p-summary">{{ description }}</p>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  {% endfor %}
</div>
