---
layout: base.njk
pagination:
  data: collections.posts
  size: 10
  alias: posts
permalink: '/blog/{% if pagination.pageNumber >= 1 %}page/{{ pagination.pageNumber + 1 }}/{% endif %}index.html'
title: Blog
---

<div class="h-feed">
  <header class="blog-header">
    <h1 class="p-name blog-title">Blog</h1>
    <a class="visually-hidden u-url" href="{{ site.url }}/blog/" aria-label="Blog"></a>
    <p class="blog-lede">
      Artigos e conteúdos longos sobre acessibilidade, desenvolvimento web e a vida por trás da tela.
    </p>
    <p class="blog-count">{{ collections.posts | length }} artigos publicados</p>

    <div class="callout flow blog-rss">
      <p class="cluster" style="--gutter: var(--space-2xs)">
        {% faIcon 'rss', 'solid', 24 %}
        <a href="/feeds/blog/rss.xml">
          Assine o meu feed de publicações ou acompanhe nesta página.
        </a>
      </p>
    </div>
  </header>

  <ol class="blog-index" role="list">
    {% for post in posts %}
      {% set tags = (post.data and post.data.tags) or post.tags or [] %}
      <li>
        <article class="blog-entry h-entry">
          <time
            class="blog-date dt-published"
            datetime="{{ post.date | htmlDateString }}">
            {{ post.date | readableDate }}
          </time>
          <h3 class="blog-entry-title p-name">
            <a class="u-url" href="{{ post.url }}">{{ post.data.title }}</a>
          </h3>
          <p class="blog-entry-summary p-summary">
            {{ post.data.description or (post.templateContent | striptags | truncate(160)) }}
          </p>
          {% if tags %}
            <ul class="cluster blog-entry-tags" role="list" style="--gutter: var(--space-2xs)">
              {% for tag in tags %}
                <li>
                  <a class="p-category" href="/tags/{{ tag | slug }}/">#{{ tag }}</a>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </article>
      </li>
    {% endfor %}
  </ol>

  <nav class="repel region" style="--region-space: var(--space-l)" aria-label="Paginação">
    {% if pagination.href.previous %}
      <a class="button" href="{{ pagination.href.previous }}" rel="prev">Anterior</a>
    {% else %}
      <span class="button" aria-disabled="true">Anterior</span>
    {% endif %}

    <span class="meta blog-folio">
      Página {{ pagination.pageNumber + 1 }} de {{ pagination.pages | length }}
    </span>

    {% if pagination.href.next %}
      <a class="button" href="{{ pagination.href.next }}" rel="next">Próximo</a>
    {% else %}
      <span class="button" aria-disabled="true">Próximo</span>
    {% endif %}
  </nav>
</div>
