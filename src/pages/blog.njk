---
layout: base.njk
permalink: '/blog/index.html'
title: Blog
---

<div class="h-feed">
  <header class="blog-header">
    <h1 class="p-name blog-title">Blog</h1>
    <a class="visually-hidden u-url" href="{{ meta.url }}/blog/" aria-label="Blog"></a>
    <p class="blog-lede">
      Artigos e conteúdos longos sobre acessibilidade, desenvolvimento web e a vida por trás da tela.
    </p>
    <p class="blog-count">{{ collections.posts | length }} artigos publicados</p>

    <div class="callout flow blog-rss">
      <p class="cluster" style="--gutter: var(--space-2xs)">
        {% faIcon 'rss', 'solid', 24 %}
        <a href="/feeds/blog/rss.xml">
          Assine o meu feed do blog.
        </a>
      </p>
    </div>
  </header>

  {% set yearGroups = collections.posts | archiveByYear %}

  <nav class="cluster blog-subnav" style="--gutter: var(--space-s-m)" aria-label="Navegação do arquivo">
    <span class="blog-subnav-current" aria-current="true">Todas as postagens</span>
    <a href="/blog/categorias/">Categorias</a>
    <a href="/tags/">Tags</a>
  </nav>

  <p class="blog-count blog-archive-count">
    Arquivo completo: {{ collections.posts | length }} artigos publicados desde {{ (yearGroups | last).year }}.
  </p>

  <nav class="blog-jump" aria-label="Pular para o ano">
    <span class="meta blog-jump-label">Pular para o ano</span>
    <ol class="cluster blog-jump-list" role="list" style="--gutter: var(--space-s-m)">
      {% for yearGroup in yearGroups %}
        <li>
          <a href="#year-{{ yearGroup.year }}">{{ yearGroup.year }}</a>
        </li>
      {% endfor %}
    </ol>
  </nav>

  {% for yearGroup in yearGroups %}
    <section
      id="year-{{ yearGroup.year }}"
      class="blog-year"
      aria-labelledby="year-{{ yearGroup.year }}-title">
      <h2 id="year-{{ yearGroup.year }}-title" class="blog-year-title">{{ yearGroup.year }}</h2>
      <ol class="blog-index" role="list">
        {% for post in yearGroup.items %}
          <li>
            <article class="blog-entry h-entry">
              <time
                class="blog-date dt-published"
                datetime="{{ post.date | htmlDateString }}">
                {{ post.date | readableDate('DD de MMM') }}
              </time>
              <h3 class="blog-entry-title p-name">
                <a class="u-url" href="{{ post.url }}">{{ post.data.title }}</a>
              </h3>
            </article>
          </li>
        {% endfor %}
      </ol>
    </section>
  {% endfor %}
</div>