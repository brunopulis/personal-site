---
layout: base.njk
permalink: '/guestbook/'
title: Livro de visitas
---

<div style="max-width: 56rem;">
  <section class="region" style="--region-space: var(--space-l)">
    <h1>
      {% faIcon 'book', 'solid', '1em' %} Livro de visitas
    </h1>
    <p class="meta">
      Deixe sua marca! Escreva uma mensagem, um conselho, ou só um "oi" mesmo.
    </p>
  </section>

  <section class="callout mb-8" style="background-color: var(--color-surface); border-color: var(--color-surface-raised); border-style: solid; padding: var(--space-m);">
    <h2 class="mb-4">Deixe sua mensagem</h2>
    <form id="guestbook-form" class="flow" style="--flow-space: var(--space-s)">
      <div>
        <label for="name" class="mb-1 font-medium text-sm">Nome</label>
        <input
          type="text"
          id="name"
          name="name"
          required
          maxlength="100"
          class="w-full focus:outline-none focus:ring-2 focus:ring-vista-blue-500"
          placeholder="Seu nome"
        />
      </div>

      <div>
        <label for="message" class="mb-1 font-medium text-sm">Mensagem</label>
        <textarea
          id="message"
          name="message"
          required
          maxlength="2000"
          rows="4"
          class="w-full focus:outline-none focus:ring-2 focus:ring-vista-blue-500"
          placeholder="Escreva sua mensagem..."
        ></textarea>
      </div>

      <div aria-hidden="true" class="hidden">
        <label for="honeypot">Não preencha</label>
        <input type="text" id="honeypot" name="honeypot" tabindex="-1" autocomplete="off" />
      </div>

      <div id="form-feedback" class="hidden"></div>

      <button
        type="submit"
        class="font-bold"
      >
        Enviar mensagem
      </button>
    </form>
  </section>

  <section>
    <h2 class="mb-4">
      Mensagens
      <span id="message-count" class="meta">({{ guestbook.messages.length }})</span>
    </h2>

    {% if guestbook.messages.length == 0 %}
      <p id="empty-state" class="py-8 meta text-center">
        Nenhuma mensagem ainda. Seja o primeiro a escrever!
      </p>
    {% endif %}

    <div id="messages-list" class="flow" style="--flow-space: var(--space-s)">
      {% for entry in guestbook.messages | reverse %}
        <article class="callout flow" style="--flow-space: var(--space-2xs); background-color: var(--color-surface); border-color: var(--color-surface-raised); border-style: solid; padding: var(--space-xs);">
          <div class="repel" style="--repel-vertical-alignment: flex-start;">
            <strong style="color: var(--color-brand)">{{ entry.name }}</strong>
            <time class="meta" datetime="{{ entry.timestamp }}">
              {{ entry.timestamp | readableDate }}
            </time>
          </div>
          <p>{{ entry.message }}</p>
        </article>
      {% endfor %}
    </div>
  </section>
</div>

<script src="/assets/js/guestbook.js" defer></script>
