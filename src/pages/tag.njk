---
layout: base
pagination:
  data: collections.tagsPages
  size: 1
  alias: tagPage
permalink: '{{ tagPage.subPagination.pageHref }}'
eleventyComputed:
  title: "Tag: {{ tagPage.name }}"
  description: "Conteúdos marcados com a tag #{{ tagPage.name }}."
---

<div class="h-feed region" style="--region-space: var(--space-l)">
  <h1 class="p-name">Tag: {{ tagPage.name }}</h1>
  <a class="u-url" href="/tags/">
    Todas tags
  </a>
  <p class="pb-4">Conteúdos marcados com a tag <strong>#{{ tagPage.name }}</strong>.</p>

  {% set groups = tagPage.items | groupByContentType %}
  {% for group in groups %}
    <h2 class="meta">{{ group.type }}</h2>
    <div class="flow" style="--flow-space: var(--space-l)">
      {% for item in group.items %}
        <article class="pb-6 border-b h-entry flow" style="--flow-space: var(--space-2xs)">
          <h3 class="p-name">
            <a class="u-url" href="{{ item.url }}">{{ item.data.title }}</a>
          </h3>
          <time
            class="meta dt-published"
            datetime="{{ item.date | htmlDateString }}">
            {{ item.date | readableDate }}
          </time>
          <p class="p-summary">
            {{ item.data.description or (item.templateContent | striptags | truncate(160)) }}
          </p>
        </article>
      {% endfor %}
    </div>
  {% endfor %}

  {% if tagPage.subPagination.pages.length > 1 %}
    <nav class="repel region" style="--region-space: var(--space-l)" aria-label="Paginação">
      {% if tagPage.subPagination.previous %}
        <a class="button" href="{{ tagPage.subPagination.href.previous }}" rel="prev">Anterior</a>
      {% else %}
        <span class="button" aria-disabled="true">Anterior</span>
      {% endif %}

      <span class="meta">
        Página {{ tagPage.subPagination.pageNumber + 1 }} de {{ tagPage.subPagination.pages.length }}
      </span>

      {% if tagPage.subPagination.next %}
        <a class="button" href="{{ tagPage.subPagination.href.next }}" rel="next">Próximo</a>
      {% else %}
        <span class="button" aria-disabled="true">Próximo</span>
      {% endif %}
    </nav>
  {% endif %}
</div>