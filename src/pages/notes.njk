---
layout: page
pagination:
  data: collections.notes
  size: 10
  alias: notes
permalink: '/notes/{% if pagination.pageNumber > 0 %}page/{{ pagination.pageNumber + 1 }}/{% endif %}'
title: Notas
description: Ideias curtas e fáceis de conectar, cada nota tem seu próprio link permanente.
---

<div class="h-feed flow">
  <header class="notes-header">
    <p class="notes-count">
      {{ collections.notes | length }} notas publicadas
    </p>

    <div class="callout flow blog-rss">
      <p class="cluster" style="--gutter: var(--space-2xs)">
        {% faIcon 'rss', 'solid', 24 %}
        <a href="/feeds/notes/rss.xml">
          Assine meu RSS de notas.
        </a>
      </p>
    </div>
  </header>

  {% for note in notes %}
    {% set tags = ((note.data and note.data.tags) or note.tags or []) | reject('equalto', 'notes') | list %}
    <article class="note-entry h-entry">
      <a class="note-date u-url" href="{{ note.url }}">
        <time class="dt-published" datetime="{{ note.date | htmlDateString }}">
          {{ note.date | readableDate }}
        </time>
      </a>
      <div class="note-content e-content prose">
        {{ note.content | safe }}
      </div>
      {% if tags %}
        <ul class="cluster note-entry-tags" role="list" style="--gutter: var(--space-2xs)">
          {% for tag in tags %}
            <li><a class="p-category" href="/tags/{{ tag | slug }}/">#{{ tag }}</a></li>
          {% endfor %}
        </ul>
      {% endif %}
    </article>
  {% endfor %}

  <nav class="repel region" style="--region-space: var(--space-l)" aria-label="Paginação">
    {% if pagination.href.previous %}
      <a class="button" href="{{ pagination.href.previous }}" rel="prev">Anterior</a>
    {% else %}
      <span class="button" aria-disabled="true">Anterior</span>
    {% endif %}

    <span class="notes-folio">
      Página {{ pagination.pageNumber + 1 }} de {{ pagination.pages | length }}
    </span>

    {% if pagination.href.next %}
      <a class="button" href="{{ pagination.href.next }}" rel="next">Próximo</a>
    {% else %}
      <span class="button" aria-disabled="true">Próximo</span>
    {% endif %}
  </nav>
</div>
