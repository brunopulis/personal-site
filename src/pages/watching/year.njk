---
layout: base.njk
pagination:
  data: collections.watchingYears
  size: 1
  alias: year
permalink: /watching/{{ year }}/
generate: true
---

<section class="region" style="--region-space: var(--space-l)">
  <nav class="mb-4 text-sm" aria-label="Breadcrumb">
    <a href="/watching/">Filmes e séries em:</a>
    <strong>{{ year }}</strong>
  </nav>

  {% set allMovies = collections.movies %}
  {% set allShows = collections.shows %}
  {% set allItems = allMovies | concat(allShows) %}
  {% set yearsGrouped = allItems | groupByYear %}
  {% set years = yearsGrouped.years %}
  {% set currentYear = year %}

  <div class="cluster mb-6 watching-years">
    {% for item in years %}
      <a href="/watching/{{ item }}/" data-state="{{ 'active' if item == currentYear }}">
        {{ item }}
      </a>
    {% endfor %}
  </div>

  <h1 class="mb-2">{{ year }}</h1>
  <p class="mb-4 text-errie-black-900">
    Filmes e séries assistidos em {{ year }}.
  </p>
</section>

{% set yearMovies = collections.movies | filterByYear(year) %}
{% set yearShows = collections.shows | filterByYear(year) %}
{% set recentMovies = yearMovies | sortByDate | limit(6) %}
{% set recentShows = yearShows | sortByDate | limit(6) %}
{% set favoriteMovies = yearMovies | filterFavorites | sortByDate | limit(6) %}
{% set favoriteShows = yearShows | filterFavorites | sortByDate | limit(6) %}

{% if recentMovies.length > 0 %}
<section class="region" style="--region-space: var(--space-2xl)" aria-labelledby="recent-movies">
  <div class="cluster mb-6" style="--gutter: var(--space-xs)">
    <h2 id="recent-movies">
      {% faIcon 'film', 'solid', '1em' %} Filmes Recentes
    </h2>
    <a href="/watching/movies/" class="text-sm" style="color: var(--color-link)">
      Ver todos <span class="visually-hidden">os filmes recentes</span>
    </a>
  </div>

  <div class="grid" style="--grid-min-item-size: 12rem; --gutter: var(--space-xs)">
    {% for movie in recentMovies %}
      <article>
        <a href="{{ movie.url }}" class="block">
          {% if movie.data.poster %}
            <div class="frame" style="--n: 7; --d: 10;">
              <img
                src="{{ movie.data.poster | localPoster }}"
                alt=""
                loading="lazy"
              >
            </div>
          {% else %}
            <div class="frame" style="--n: 7; --d: 10; background-color: var(--color-surface);">
              <span class="font-bold text-brand text-2xl">{{ movie.data.title | truncate(1, true, "") }}</span>
            </div>
          {% endif %}
          <div class="mt-2">
            <h3 class="text-sm line-clamp-2">
              {{ movie.data.title }}
            </h3>
            <p class="py-2 meta">{{ movie.data.director }}</p>
            {% if movie.data.rating %}
              <p class="cluster text-xs" style="--gutter: var(--space-3xs); color: var(--color-star);">
                {% for i in range(1, 6) %}
                  {% if i <= movie.data.rating %}{% faIcon 'star', 'solid', '0.75em' %}{% endif %}
                {% endfor %}
              </p>
            {% endif %}
          </div>
        </a>
      </article>
    {% endfor %}
  </div>
</section>
{% endif %}

