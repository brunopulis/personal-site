---
layout: base.njk
title: Séries
permalink: /watching/shows/
---

<section class="region" style="--region-space: var(--space-l)">
  <nav class="text-sm mb-4" aria-label="Breadcrumb">
    <div class="cluster" style="--gutter: var(--space-2xs)">
      <a href="/watching/" class="font-bold">Watching</a>
      <span aria-hidden="true">→</span>
      <span>Séries</span>
    </div>
  </nav>
  <h1 class="mb-2">Séries</h1>
  <p class="meta">
    Todas as séries que assisti.
  </p>
</section>

{% set showsGrouped = collections.shows | showsByYear %}

{% for year in showsGrouped.years %}
  {% set yearShows = showsGrouped.byYear[year] %}
  {% set showCount = yearShows | length %}

  <section class="region" style="--region-space: var(--space-2xl)">
    <div class="cluster mb-6" style="--gutter: var(--space-xs)">
      <h2>{{ year }}</h2>
      <span class="meta bg-surface px-3 py-1 border rounded-full">
        {{ showCount }} {{ "série" if showCount == 1 else "séries" }}
      </span>
    </div>

    <div class="grid" style="--grid-min-item-size: 12rem; --gutter: var(--space-xs)">
      {% for show in yearShows | sortByDate %}
        <article>
          <a href="{{ show.url }}" class="block">
            {% if show.data.poster %}
              <div class="frame" style="--n: 7; --d: 10;">
                <img
                  src="{{ show.data.poster | localPoster }}"
                  alt=""
                  loading="lazy"
                >
              </div>
            {% else %}
              <div class="frame" style="--n: 7; --d: 10; background: linear-gradient(to bottom right, var(--color-vista-blue-500), var(--color-blood-red-500));">
                <span class="font-bold text-white text-2xl">{{ show.data.title | truncate(1, true, "") }}</span>
              </div>
            {% endif %}
            <div class="mt-2">
              <h3 class="text-sm line-clamp-2">{{ show.data.title }}</h3>
              {% if show.data.category %}
                <p class="meta">{{ show.data.category }}</p>
              {% endif %}
              {% if show.data.rating %}
                <p class="cluster text-xs" style="--gutter: var(--space-3xs); color: var(--color-star);">
                  {% for i in range(1, 6) %}
                    {% if i <= show.data.rating %}⭐{% endif %}
                  {% endfor %}
                </p>
              {% endif %}
            </div>
          </a>
        </article>
      {% endfor %}
    </div>
  </section>
{% else %}
  <p class="py-12 meta text-center">
    Nenhuma série registrada ainda.
  </p>
{% endfor %}
