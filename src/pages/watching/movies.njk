---
layout: base.njk
title: Filmes
permalink: /watching/movies/
---

<section class="region" style="--region-space: var(--space-l)">
  <nav class="mb-4 text-sm" aria-label="Breadcrumb">
    <div class="cluster" style="--gutter: var(--space-2xs)">
      <a href="/watching/" class="font-bold text-2xl">
        Filmes e Séries
      </a>
      {% faIcon 'arrow-right', 'solid', '1em' %}
      <span>Filmes</span>
    </div>
  </nav>
  <h1 class="mb-2">Filmes</h1>
  <p class="meta">
    Todos os filmes que assisti.
  </p>
</section>

{% set moviesGrouped = collections.movies | moviesByYear %}

{% for year in moviesGrouped.years %}
  {% set yearMovies = moviesGrouped.byYear[year] %}
  {% set movieCount = yearMovies | length %}

  <section class="region" style="--region-space: var(--space-2xl)">
    <div class="cluster mb-6" style="--gutter: var(--space-xs)">
      <h2>{{ year }}</h2>
      <span class="meta bg-surface px-3 py-1 border rounded-full">
        {{ movieCount }} {{ "filme" if movieCount == 1 else "filmes" }}
      </span>
    </div>

    <div class="grid" style="--grid-min-item-size: 12rem; --gutter: var(--space-xs)">
      {% for movie in yearMovies | sortByDate %}
        <article>
          <a href="{{ movie.url }}" class="block">
            {% if movie.data.poster %}
              <div class="frame" style="--n: 7; --d: 10;">
                <img
                  src="{{ movie.data.poster | localPoster }}"
                  alt=""
                  loading="lazy"
                >
              </div>
            {% else %}
              <div class="frame" style="--n: 7; --d: 10; background-color: var(--color-surface);">
                <span class="font-bold text-brand text-2xl">{{ movie.data.title | truncate(1, true, "") }}</span>
              </div>
            {% endif %}
            <div class="mt-2">
              <h3 class="text-sm line-clamp-2">{{ movie.data.title }}</h3>
              {% if movie.data.director %}
                <p class="meta">{{ movie.data.director }}</p>
              {% endif %}
              {% if movie.data.rating %}
                <p class="cluster text-xs" style="--gutter: var(--space-3xs); color: var(--color-star);">
                  {% for i in range(1, 6) %}
                    {% if i <= movie.data.rating %}{% faIcon 'star', 'solid', '0.75em' %}{% endif %}
                  {% endfor %}
                </p>
              {% endif %}
            </div>
          </a>
        </article>
      {% endfor %}
    </div>
  </section>
{% else %}
  <p class="py-12 meta text-center">
    Nenhum filme registrado ainda.
  </p>
{% endfor %}
