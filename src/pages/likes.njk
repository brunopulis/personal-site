---
layout: base
pagination:
  data: collections.likes
  size: 10
  alias: likes
permalink: '/likes/{% if pagination.pageNumber > 0 %}page/{{ pagination.pageNumber + 1 }}/{% endif %}'
title: Likes
---

<div class="h-feed">
  <h1 class="p-name" lang="en">
    {{ title }}
  </h1>
  <a class="visually-hidden u-url" href="{{ site.url }}/likes/"></a>
  <p>Uma coleção de links e ideias que gostei.</p>

  <section class="flow" style="--flow-space: var(--space-l)">
    {% for like in likes %}
      <article class="callout flow h-entry" style="background-color: var(--color-light-silver-100); border-color: var(--color-light-silver-100); border-style: solid; --flow-space: var(--space-s);">
        <time class="meta font-bold dt-published" datetime="{{ like.date | htmlDateString }}">
          {{ like.date | readableDate }}
        </time>

        <div class="e-content prose">
          {{ like.content | safe }}
        </div>
      </article>
    {% endfor %}
  </section>

  <nav class="repel region" style="--region-space: var(--space-l)" aria-label="Pagination">
    {% if pagination.href.previous %}
      <a class="button" href="{{ pagination.href.previous }}">Anterior</a>
    {% else %}
      <span></span>
    {% endif %}
    {% if pagination.href.next %}
      <a class="button" href="{{ pagination.href.next }}">Próximo</a>
    {% endif %}
  </nav>
</div>
