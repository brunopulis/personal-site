---
layout: base
title: "Filmes e Séries"
permalink: /watching/
---

<div class="h-feed">
  {% set allMovies = collections.movies %}
  {% set allShows = collections.shows %}
  {% set watchedMidia = collections.books | where('data.status', 'lido') %}
  {% set allItems = allMovies | concat(allShows) %}
  {% set yearsGrouped = allItems | groupByYear %}
  {% set years = yearsGrouped.years %}
  {% set currentYear = years[0] %}
  {% set categories = allItems | mediaCategories %}

  <header class="blog-header">
    <h1 class="p-name blog-title">{{ title }}</h1>
    <p class="blog-lede">
      Filmes e séries que assisti, apresentados de forma organizada.
      {% if latestYear %}
        Já terminei {{ latestYearCount }} {{ "livro" if latestYearCount == 1 else "livros" }} em {{ latestYear }}.
      {% endif %}
    </p>
    <p class="blog-count">
      {{ lidos | length }} midias vistas
    </p>

    <div class="callout flow blog-rss">
      <p class="cluster" style="--gutter: var(--space-2xs)">
        {% faIcon 'rss', 'solid', 24 %}
        <a href="/feeds/shows/rss.xml">
          Acompanhe <span lang="en">feed</span> dos filmes e séries.
        </a>
      </p>
    </div>
  </header>

  {% if categories.length > 0 %}
  <fieldset class="bookshelf-filter" data-bookshelf-filter>
    <legend class="bookshelf-filter-legend">Filtrar por:</legend>
    <div class="bookshelf-filter-options repel" style="gap: 1rem 0.85rem;">
      <input class="visually-hidden bookshelf-filter-input" type="radio" name="categoria" id="filter-todos" value="todos" checked>
      <label class="bookshelf-filter-label" for="filter-todos">Todos</label>
      {% for cat in categories %}
        <input
          class="visually-hidden bookshelf-filter-input"
          type="radio"
          name="categoria"
          id="filter-{{ cat.name | slugify }}"
          value="{{ cat.name | slugify }}"
        >
        <label class="bookshelf-filter-label" for="filter-{{ cat.name | slugify }}">{{ cat.name }}</label>
      {% endfor %}
    </div>
  </fieldset>
  {% endif %}

  {% set recentMovies = collections.movies | sortByDate | limit(12) %}
  {% set recentShows = collections.shows | sortByDate | limit(12) %}
  {% set favoriteMovies = collections.movies | filterFavorites | sortByDate | limit(12) %}
  {% set favoriteShows = collections.shows | filterFavorites | sortByDate | limit(12) %}

  {% if recentMovies.length > 0 %}
  <section class="region" style="--region-space: var(--space-2xl)" aria-labelledby="recent-movies">
    <div class="cluster mb-6" style="--gutter: var(--space-xs)">
      <h2 id="recent-movies">
        {% faIcon 'film', 'solid', '1em' %} Filmes Recentes
      </h2>
      <a href="/watching/movies/" class="text-sm" style="color: var(--color-link)">Ver todos →</a>
    </div>

    {% if recentMovies.length > 0 %}
    <div class="grid h-feed" style="--grid-min-item-size: 12rem; --gutter: var(--space-xs)">
      {% for movie in recentMovies %}
        {% set moviesCount = yearBooks | length %}
        <article class="mb-5 h-entry watching-filter-item" data-categories="{{ movie.data.category | categoriesSlugs }}">
          <a href="{{ movie.url }}" class="block">
            {% if movie.data.poster %}
              <div class="frame" style="--n: 7; --d: 10;">
                <img
                  src="{{ movie.data.poster | localPoster }}"
                  alt=""
                  loading="lazy"
                >
              </div>
            {% else %}
              <div class="frame" style="--n: 7; --d: 10; background-color: var(--color-surface);">
                <span class="font-bold text-brand text-2xl">
                  {{ movie.data.title | truncate(1, true, "") }}
                </span>
              </div>
            {% endif %}
            <p class="meta">{{ movie.data.director }}</p>
            <div class="mt-2">
              <h3 class="text-sm line-clamp-2">
                {{ movie.data.title }}
              </h3>
              {% if movie.data.rating %}
                <p class="cluster text-xs" style="--gutter: var(--space-3xs); color: var(--color-star);">
                  {% for i in range(1, 6) %}
                    {% if i <= movie.data.rating %}{% faIcon 'star', 'solid', '0.75em' %}{% endif %}
                  {% endfor %}
                </p>
              {% endif %}
            </div>
          </a>
        </article>
      {% endfor %}
    </div>
    {% else %}
      <p>Nenhum filme registrado ainda.</p>
    {% endif %}
  </section>
  {% endif %}

  {% if recentShows.length > 0 %}
  <section class="region" style="--region-space: var(--space-2xl)" aria-labelledby="shows-title">
    <div class="cluster mb-6" style="--gutter: var(--space-xs)">
      <h2 id="shows-title">Séries Recentes</h2>
      <a href="/watching/shows/" class="text-sm" style="color: var(--color-link)">Ver todos →</a>
    </div>

    {% if recentShows.length > 0 %}
    <div class="grid h-feed" style="--grid-min-item-size: 12rem; --gutter: var(--space-xs)">
      {% for show in recentShows %}
        <article class="mb-5 h-entry watching-filter-item" data-categories="{{ show.data.category | categoriesSlugs }}">
          <a href="{{ show.url }}" class="block">
            {% if show.data.poster %}
              <div class="frame" style="--n: 7; --d: 10;">
                <img
                  src="{{ show.data.poster | localPoster }}"
                  alt=""
                  loading="lazy"
                >
              </div>
            {% else %}
              <div class="frame" style="--n: 7; --d: 10; background-color: var(--color-surface);">
                <span class="font-bold text-brand text-2xl">{{ show.data.title | truncate(1, true, "") }}</span>
              </div>
            {% endif %}
            <div class="py-2">
              <h3 class="text-sm line-clamp-2">
                {{ show.data.title }}
              </h3>
              {% if show.data.rating %}
                <p class="cluster text-xs" style="--gutter: var(--space-3xs); color: var(--color-star);">
                  {% for i in range(1, 6) %}
                    {% if i <= show.data.rating %}{% faIcon 'star', 'solid', '0.75em' %}{% endif %}
                  {% endfor %}
                </p>
              {% endif %}
            </div>
          </a>
        </article>
      {% endfor %}
    </div>
    {% else %}
      <p>Nenhum seriado registrado ainda.</p>
    {% endif %}
  </section>
  {% endif %}

  {% if categories.length > 0 %}
    <script src="/assets/js/bookshelf-filter.js" defer></script>
  {% endif %}

  {% if yearMovies.length == 0 and yearShows.length == 0 %}
  <p class="py-12 text-center">
    Nenhum filme ou série registrado para {{ year }}.
  </p>
  {% endif %}
</div>
