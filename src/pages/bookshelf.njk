---
layout: base.njk
title: Estante de Livros
permalink: /bookshelf/
---

<section class="region" style="--region-space: var(--space-l)">
  <h1>
    {{ title }}
  </h1>
  <p>Livros que li, organizados por ano de leitura.</p>
</section>

{% set booksGrouped = collections.books | booksByYear %}
{% for year in booksGrouped.years %}
  {% set yearBooks = booksGrouped.byYear[year] %}
  {% set bookCount = yearBooks | length %}

  <section class="region" style="--region-space: var(--space-2xl)">
    <div class="cluster mb-6" style="--gutter: var(--space-xs)">
      <h2>{{ year }}</h2>
      <span class="badge p-category" data-variant="accent">
        {{ bookCount }} {{ "livro" if bookCount == 1 else "livros" }}
      </span>
    </div>

    <div class="grid" style="--grid-min-item-size: 13.5rem; --gutter: var(--space-m);">
      {% for book in yearBooks | reverse %}
        {% set hasReview = book.content | striptags | trim | length > 0 %}
        <article>
          <div class="py-4">
            {% if book.data.poster %}
              <div class="frame" style="--n: 2; --d: 3; width: 100%;">
                <img
                  src="{{ book.data.poster }}"
                  alt="{{ book.data.title }}"
                  loading="lazy"
                >
              </div>
            {% else %}
              <div class="frame" style="--n: 2; --d: 3; width: 100%; background-color: var(--color-light-silver-500);">
                <span class="font-bold text-white text-2xl">{{ book.data.title | truncate(1, true, "") }}</span>
              </div>
            {% endif %}

            <div class="flow" style="--flow-space: var(--space-2xs); margin-block: var(--space-s);">
              <h3 class="line-clamp-2">
                {{ book.data.title }}
              </h3>

              {% if book.data.subtitle %}
                <p class="meta">
                  {{ book.data.subtitle }}
                </p>
              {% endif %}
            </div>

            {% if book.data.author %}
              <p class="mb-2 meta">
                {{ book.data.author }}
              </p>
            {% endif %}

            {% if book.data.rating %}
              <div class="cluster mb-2" style="--gutter: var(--space-3xs)" role="img" aria-label="Nota: {{ book.data.rating }} de 5">
                {% for ratingCount in range(1, 6) %}
                  {% if ratingCount <= book.data.rating %}
                    <svg width="20" height="20" fill="currentColor" viewBox="0 0 20 20" style="color: var(--color-star)" aria-hidden="true">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                  {% else %}
                    <svg width="20" height="20" fill="currentColor" viewBox="0 0 20 20" style="color: var(--color-star-empty)" aria-hidden="true">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}

            {% if hasReview %}
              <a href="{{ book.url }}" class="text-sm">
                Leia a minha resenha
              </a>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </section>
{% else %}
  <p class="py-12 meta text-center">
    Nenhum livro registrado ainda.
  </p>
{% endfor %}
