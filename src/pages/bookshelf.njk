---
layout: base.njk
title: Estante de Livros
permalink: /bookshelf/
---

<section class="region bookshelf-header">
  <h1 class="bookshelf-title">
    {{ title }}
  </h1>
  <p class="bookshelf-lede">Livros que li, organizados por ano de leitura.</p>
</section>

{% set booksGrouped = collections.books | booksByYear %}
{% for year in booksGrouped.years %}
  {% set yearBooks = booksGrouped.byYear[year] %}
  {% set bookCount = yearBooks | length %}

  <section class="region bookshelf-year">
    <div class="cluster bookshelf-year-header">
      <h2>{{ year }}</h2>
      <span class="bookshelf-year-count p-category">
        {{ bookCount }} {{ "livro" if bookCount == 1 else "livros" }}
      </span>
    </div>

    <ul class="grid bookshelf-grid" role="list">
      {% for book in yearBooks | reverse %}
        {% set hasReview = book.content | striptags | trim | length > 0 %}
        <li>
          <a href="{{ book.url }}" class="bookshelf-cover-link" aria-label="{{ book.data.title }}">
            {% if book.data.poster %}
              <div class="frame bookshelf-cover">
                <img
                  src="{{ book.data.poster }}"
                  alt="{{ book.data.title }}"
                  loading="lazy"
                >
              </div>
            {% else %}
              <div class="frame bookshelf-cover-placeholder">
                <span>{{ book.data.title | truncate(1, true, "") }}</span>
              </div>
            {% endif %}
            {% if hasReview %}
              <span class="bookshelf-review-badge">resenha</span>
            {% endif %}
          </a>
        </li>
      {% endfor %}
    </ul>
  </section>
{% else %}
  <p class="bookshelf-empty">
    Nenhum livro registrado ainda.
  </p>
{% endfor %}
