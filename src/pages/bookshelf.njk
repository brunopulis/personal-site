---
layout: base
title: Meus livros
permalink: /bookshelf/
---

<div class="h-feed">
  {% set booksGrouped = collections.books | booksByYear %}
  {% set lendo = collections.books | currentlyReading %}
  {% set lidos = collections.books | where('data.status', 'lido') %}
  {% set categories = lidos | bookCategories %}
  {% set latestYear = booksGrouped.years[0] %}
  {% set latestYearBooks = booksGrouped.byYear[latestYear] or [] %}
  {% set latestYearCount = latestYearBooks | length %}

  <header class="blog-header">
    <h1 class="p-name blog-title">{{ title }}</h1>
    <p class="blog-lede">
      Aqui está o que estou lendo no momento.
      {% if latestYear %}
        Já terminei {{ latestYearCount }} {{ "livro" if latestYearCount == 1 else "livros" }} em {{ latestYear }}.
      {% endif %}
    </p>
    <p class="blog-count">
      {{ lidos | length }} livros lidos
    </p>

    <div class="callout flow blog-rss">
      <p class="cluster" style="--gutter: var(--space-2xs)">
        {% faIcon 'rss', 'solid', 24 %}
        <a href="/feeds/books/rss.xml">
          Acompanhe <span lang="en">feed</span> dos meus livros.
        </a>
      </p>
    </div>
  </header>

  {% if categories.length > 0 %}
    <fieldset class="bookshelf-filter" data-bookshelf-filter>
      <legend class="bookshelf-filter-legend">Filtrar por:</legend>
      <div class="bookshelf-filter-options repel" style="gap: 1rem 0.85rem;">
        <input class="visually-hidden bookshelf-filter-input" type="radio" name="categoria" id="filter-todos" value="todos" checked>
        <label class="bookshelf-filter-label" for="filter-todos">Todos</label>
        {% for cat in categories %}
          <input
            class="visually-hidden bookshelf-filter-input"
            type="radio"
            name="categoria"
            id="filter-{{ cat.name | slugify }}"
            value="{{ cat.name | slugify }}"
          >
          <label class="bookshelf-filter-label" for="filter-{{ cat.name | slugify }}">{{ cat.name }}</label>
        {% endfor %}
      </div>
    </fieldset>
  {% endif %}

  {% for year in booksGrouped.years %}
    {% set yearBooks = booksGrouped.byYear[year] %}
    {% set bookCount = yearBooks | length %}

    <section class="region bookshelf-year" data-year="{{ year }}">
      <div class="cluster bookshelf-year-header">
        <h2>{{ year }}</h2>
        <span class="bookshelf-year-count p-category">
          {{ bookCount }} {{ "livro" if bookCount == 1 else "livros" }}
        </span>
      </div>

      <ul class="grid bookshelf-books" role="list">
        {% for book in yearBooks | reverse %}
          {% set hasReview = book.content | striptags | trim | length > 0 %}
          <li class="bookshelf-book h-entry" data-category="{{ book.data.category | slugify }}">
            <a
              href="{{ book.url }}"
              class="bookshelf-cover-link"
              aria-label="Capa do livro: {{ book.data.title }}"
            >
              {% if book.data.poster %}
                <div class="frame bookshelf-cover">
                  <img
                    src="{{ book.data.poster }}"
                    alt=""
                    eleventy:widths="360"
                    loading="lazy"
                    decoding="async"
                  >
                </div>
              {% else %}
                <div class="frame bookshelf-cover-placeholder">
                  <span>{{ book.data.title | truncate(1, true, "") }}</span>
                </div>
              {% endif %}
            </a>
            <div class="bookshelf-info flow">
              <h3 class="p-name">{{ book.data.title }}</h3>
              {% if book.data.author %}
                <p class="bookshelf-author">{{ book.data.author }}</p>
              {% endif %}
              {% if book.data.rating %}
                <p class="bookshelf-rating" role="img" aria-label="Nota {{ book.data.rating }} de 5">
                  {% for i in range(1, 6) %}{{ '★' if i <= book.data.rating else '☆' }}{% endfor %}
                </p>
              {% endif %}
              {% if hasReview %}
                <a href="{{ book.url }}" class="bookshelf-review-link">
                  Leia minha resenha <span class="visually-hidden">do livro: {{ book.data.title }}</span>
                </a>
              {% endif %}
            </div>
          </li>
        {% endfor %}
      </ul>
    </section>
  {% endfor %}
</div>

{% if booksGrouped.years.length > 0 %}
  <script src="/assets/js/bookshelf-filter.js" defer></script>
{% endif %}
