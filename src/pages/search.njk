---
layout: base.njk
permalink: '/search/'
title: Busca
description: Pesquise conteúdo em todo o site.
---

<div class="max-w-2xl flow" style="--flow-space: var(--space-2xs)">
  <h1>Busca</h1>
  <p class="meta">Pesquise por artigos, notas, livros, filmes e mais.</p>

  <link href="/pagefind/pagefind-ui.css" rel="stylesheet">
  <div id="search" class="region" style="--region-space: var(--space-l)"></div>
  <script src="/pagefind/pagefind-ui.js" type="text/javascript"></script>
  <script>
    window.addEventListener('DOMContentLoaded', () => {
      if (typeof window.PagefindUI === 'undefined') return;

      new PagefindUI({
        element: '#search',
        showSubResults: true,
        showImages: false,
        resetStyles: false
      });

      const search = document.querySelector('#search');
      const patchInput = () => {
        const input = search && search.querySelector('input');
        if (input && !input.hasAttribute('aria-label')) {
          input.setAttribute('aria-label', 'Pesquisar no site');
          input.removeAttribute('title');
        }
      };
      if (search) {
        new MutationObserver(patchInput).observe(search, {childList: true, subtree: true});
      }
      patchInput();
    });
  </script>
</div>
