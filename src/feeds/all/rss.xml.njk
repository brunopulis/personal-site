---json
{
  "permalink": "/feeds/all/rss.xml",
  "eleventyExcludeFromCollections": true,
  "metadata": {
    "title": "Bruno Pulis - Todo o conteúdo",
    "description": "Artigos, notas, likes, livros, filmes, séries e poemas",
    "language": "pt-br",
    "base": "https://brunopulis.com",
    "author": {
      "name": "Bruno Pulis",
      "email": "brunopulis@protonmail.com"
    }
  }
}
---
<?xml version="1.0" encoding="utf-8"?>
<?xml-stylesheet href="/feeds/pretty-feed-v3.xsl" type="text/xsl"?>
{% from "partials/rss-note.njk" import rssNote %}
<rss version="2.0" xmlns:dc="http://purl.org/dc/elements/1.1/" xml:base="{{ metadata.base | addPathPrefixToFullUrl }}"
  xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ metadata.title }}</title>
    <link>{{ metadata.base | addPathPrefixToFullUrl }}</link>
    <atom:link href="{{ permalink | htmlBaseUrl(metadata.base) }}" rel="self" type="application/rss+xml" />
    <description>{{ metadata.description }}</description>
    <language>{{ metadata.language or page.lang }}</language>
    {%- for entry in collections.allFeed %}
    {%- set absoluteItemUrl = entry.item.url | htmlBaseUrl(metadata.base) %}
    <item>
      <title>{{ entry.item.data.title }}</title>
      <link>{{ absoluteItemUrl }}</link>
      <description>{{ entry.raw | renderTransforms(entry.item.data.page, metadata.base) }}{{ rssNote(entry.item.data.title) }}</description>
      <pubDate>{{ (entry.item.data.watchedDate or entry.item.data.pubDate or entry.item.date) | toRfc822Date }}</pubDate>
      <dc:creator>{{ metadata.author.name }}</dc:creator>
      <guid>{{ absoluteItemUrl }}</guid>
      <category>{{ entry.type }}</category>
    </item>
    {%- endfor %}
  </channel>
</rss>
