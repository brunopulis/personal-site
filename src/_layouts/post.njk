---
layout: base
---

<nav class="region" style="--region-space: var(--space-s)" aria-label="Breadcrumb">
  <ol class="cluster" role="list" style="--gutter: var(--space-2xs)">
    <li><a href="/">Home</a></li>
    <li><span aria-hidden="true">›</span></li>
    <li><a href="/blog/">Blog</a></li>
    <li><span aria-hidden="true">›</span></li>
    <li>{{ title }}</li>
  </ol>
</nav>

<article class="region h-entry" style="--region-space: var(--space-xl)">
  {% if featuredImage %}
    <img
      class="u-photo"
      src="{{ featuredImage }}"
      alt="Featured image for {{ title }}"
    />
  {% endif %}

  <header class="flow" style="--flow-space: var(--space-s)">
    <h1 class="p-name">{{ title }}</h1>
    {% if subtitle %}
      <p class="lede">{{ subtitle }}</p>
    {% endif %}
    <p class="meta">
      Publicado em:
      <time class="dt-published" datetime="{{ page.date | htmlDateString }}">
        {{ page.date | readableDate }}
      </time>
      por
      <span class="p-author h-card">
        <a class="p-name u-url" href="/about/">
          {{ author or site.author }}
        </a>
      </span>
      <span aria-hidden="true">•</span>
      <span>{{ content | readingTime }} min de leitura</span>
    </p>
    <a class="visually-hidden u-url" href="{{ page.url }}">Permalink</a>
  </header>

  <div class="e-content prose">
    {{ content | safe }}
  </div>

  {% if tags %}
    <nav class="cluster" style="--gutter: var(--space-2xs)" aria-label="Tags">
      <span class="meta uppercase">Tags</span>
      {% for tag in tags %}
        <a class="p-category" href="/tags/{{ tag | slug }}/">#{{ tag }}</a>
      {% endfor %}
    </nav>
  {% endif %}

  {% include "partials/share-links.njk" %}
  {% include "partials/author.njk" %}
  {% if site.newsletter.enabled %}
    {% include "partials/newsletter.njk" %}
  {% endif %}

  {% include "partials/webmentions.njk" %}
</article>
