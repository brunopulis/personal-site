---
layout: base
---

<article class="h-entry region flow" style="--region-space: var(--space-l)">
  <header class="flow" style="--flow-space: var(--space-s)">
    <h1 class="p-name" data-pagefind-meta="title">
      {{ title }}
    </h1>
  </header>

  <div class="prose flow e-content">
    {{ content | safe }}

    {% include "partials/last-modified.njk" %}
  </div>

  <a class="visually-hidden u-url" href="{{ meta.url }}{{ page.url }}">Permalink</a>
  <a class="visually-hidden u-uid" href="{{ meta.url }}{{ page.url }}">{{ meta.url }}{{ page.url }}</a>

  <div class="visually-hidden p-author h-card">
    <a class="p-name u-url" rel="author" href="{{ meta.url }}">{{ meta.author.name }}</a>
    <img class="u-photo" src="{{ meta.author.photo }}" alt="{{ meta.author.name }}" />
  </div>
</article>
