---
layout: base
title: "Filmes e Séries"
---

<nav class="region" style="--region-space: var(--space-s)" aria-label="Breadcrumb">
  <ol class="cluster" role="list" style="--gutter: var(--space-2xs)">
    <li><a href="/">Home</a></li>
    <li>{% faIcon 'chevron-right', 'solid', '0.8em' %}</li>
    <li><a href="/watching/">Filmes e Séries</a></li>
    <li>{% faIcon 'chevron-right', 'solid', '0.8em' %}</li>
    <li>{{ title }}</li>
  </ol>
</nav>

<article class="h-entry">
  <div class="cluster" style="--gutter: var(--space-s); --cluster-vertical-alignment: flex-start;">
    {% if poster %}
      <div class="frame" style="--n: 7; --d: 10; flex: 0 0 14rem;">
        <img
          class="u-photo"
          src="{{ poster | localPoster }}"
          alt="Poster de {{ title }}"
        />
      </div>
    {% endif %}

    <header class="flow" style="--flow-space: var(--space-2xs); flex: 1 1 20rem;">
      <h1 class="p-name">
        {{ title }}
      </h1>

      <div class="cluster" style="--gutter: var(--space-2xs)">
        {% if category %}
          {% for cat in category %}
          <span class="p-category badge">
            {{ cat }}
          </span>
          {% endfor %}
        {% endif %}

        {% if favorite %}
          <span class="meta" style="color: var(--color-star)" aria-label="Favorito">{% faIcon 'star', 'solid', '0.75em' %} Favorito</span>
        {% endif %}
      </div>

      {% if rating %}
        <div class="cluster" style="--gutter: var(--space-3xs)" aria-label="Nota: {{ rating }} de 5">
          {% for i in range(1, 6) %}
              {% if i <= rating %}
                {% faIcon 'star', 'solid', 20, '', '', 'color: var(--color-star)' %}
              {% else %}
                {% faIcon 'star', 'solid', 20, '', '', 'color: var(--color-star-empty)' %}
              {% endif %}
          {% endfor %}
        </div>
      {% endif %}

      {% if watchedDate %}
        <p class="meta">
          Assistido em
          <time class="dt-published" datetime="{{ watchedDate }}">
            {{ watchedDate | readableDate }}
          </time>
        </p>
      {% endif %}

      {% if url %}
        <a
          href="{{ url }}"
          target="_blank"
          rel="noopener"
          class="cluster"
          style="--gutter: var(--space-2xs)"
        >
          {% faIcon 'arrow-up-right-from-square', 'solid', 16 %}
          Ver no TMDB
        </a>
      {% endif %}

      <a class="visually-hidden u-url" href="{{ page.url }}">Permalink</a>
    </header>
  </div>

  {% if content %}
    <div class="e-content prose">
      {{ content | safe }}
    </div>
  {% endif %}
</article>
