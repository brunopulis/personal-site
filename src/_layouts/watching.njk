---
layout: base
title: "Filmes e Séries"
---

<nav class="region" style="--region-space: var(--space-s)" aria-label="Breadcrumb">
  <ol class="cluster" role="list" style="--gutter: var(--space-2xs)">
    <li><a href="/">Home</a></li>
    <li><span aria-hidden="true">›</span></li>
    <li><a href="/watching/">Filmes e Séries</a></li>
    <li><span aria-hidden="true">›</span></li>
    <li>{{ title }}</li>
  </ol>
</nav>

<article class="h-entry">
  <div class="cluster" style="--gutter: var(--space-s); --cluster-vertical-alignment: flex-start;">
    {% if poster %}
      <div class="frame" style="--n: 7; --d: 10; flex: 0 0 14rem;">
        <img
          class="u-photo"
          src="{{ poster | localPoster }}"
          alt="Poster de {{ title }}"
        />
      </div>
    {% endif %}

    <header class="flow" style="--flow-space: var(--space-2xs); flex: 1 1 20rem;">
      <h1 class="p-name">
        {{ title }}
      </h1>

      <div class="cluster" style="--gutter: var(--space-2xs)">
        {% if category %}
          {% for cat in category %}
          <span class="p-category badge">
            {{ cat }}
          </span>
          {% endfor %}
        {% endif %}

        {% if favorite %}
          <span class="meta" style="color: var(--color-star)" aria-label="Favorito">⭐ Favorito</span>
        {% endif %}
      </div>

      {% if rating %}
        <div class="cluster" style="--gutter: var(--space-3xs)" aria-label="Nota: {{ rating }} de 5">
          {% for i in range(1, 6) %}
            {% if i <= rating %}
              <svg width="20" height="20" fill="currentColor" viewBox="0 0 20 20" style="color: var(--color-star)" aria-hidden="true">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            {% else %}
              <svg width="20" height="20" fill="currentColor" viewBox="0 0 20 20" style="color: var(--color-star-empty)" aria-hidden="true">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}

      {% if watchedDate %}
        <p class="meta">
          Assistido em
          <time class="dt-published" datetime="{{ watchedDate }}">
            {{ watchedDate | readableDate }}
          </time>
        </p>
      {% endif %}

      {% if url %}
        <a
          href="{{ url }}"
          target="_blank"
          rel="noopener"
          class="cluster"
          style="--gutter: var(--space-2xs)"
        >
          <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
          </svg>
          Ver no TMDB
        </a>
      {% endif %}

      <a class="visually-hidden u-url" href="{{ page.url }}">Permalink</a>
    </header>
  </div>

  {% if content %}
    <div class="e-content prose">
      {{ content | safe }}
    </div>
  {% endif %}
</article>
