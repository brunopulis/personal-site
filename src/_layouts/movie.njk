---
layout: base
---

<article style="max-width: 56rem;">
  <header class="region" style="--region-space: var(--space-m)">
    <div class="cluster" style="--gutter: var(--space-s-m); --cluster-vertical-alignment: flex-start;">
      {% if poster %}
        <div class="frame" style="--n: 2; --d: 3; flex: 0 0 12rem;">
          <img
            src="{{ poster | localPoster }}"
            alt="{{ title }}"
            loading="lazy"
          >
        </div>
      {% endif %}
      <div style="flex: 1 1 16rem;">
        <h1>{{ title }}</h1>
        {% if director %}
          <p class="meta">Dirigido por {{ director }}</p>
        {% endif %}
        {% if rating %}
          <div class="cluster" style="--gutter: var(--space-3xs)" aria-label="Nota: {{ rating }} de 5">
            {% for i in range(1, 6) %}
              {% if i <= rating %}
                {% faIcon 'star', 'solid', 20, '', '', 'color: var(--color-star)' %}
              {% else %}
                {% faIcon 'star', 'solid', 20, '', '', 'color: var(--color-star-empty)' %}
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
        {% if url %}
          <a href="{{ url }}" target="_blank" rel="noopener" class="cluster" style="--gutter: var(--space-2xs)">
            {% faIcon 'arrow-up-right-from-square', 'solid', 16 %}
            Ver no IMDB
          </a>
        {% endif %}
      </div>
    </div>
  </header>

  <div class="prose">
    {{ content | safe }}
  </div>
</article>
