---
layout: base
title: "Meus Livros"
---

<article class="book-layout">
  <nav class="book-nav" aria-label="Breadcrumb">
    <ol class="cluster book-breadcrumb" role="list">
      <li><a href="/">Home</a></li>
      <li>{% faIcon 'chevron-right', 'solid', '0.8em' %}</li>
      <li><a href="/bookshelf/">Livros</a></li>
      <li>{% faIcon 'chevron-right', 'solid', '0.8em' %}</li>
      <li>{{ title }}</li>
    </ol>
  </nav>

  <header class="region book-header">
    <div class="cluster book-header-inner">
      {% if poster %}
        <div class="frame book-cover">
          <img
            src="{{ poster | localPoster }}"
            alt="{{ title }}"
            loading="lazy"
          >
        </div>
      {% endif %}

      <div class="book-meta">
        <h1 class="book-title">{{ title }}</h1>

        {% if author %}
          <p class="book-author">{{ author }}</p>
        {% endif %}

        {% if rating %}
          <div class="cluster book-rating" role="img" aria-label="Nota: {{ rating }} de 5">
            {% for i in range(1, 6) %}
              {% if i <= rating %}
                {% faIcon 'star', 'solid', 20, '', '', 'color: var(--color-star)' %}
              {% else %}
                {% faIcon 'star', 'solid', 20, '', '', 'color: var(--color-star-empty)' %}
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}

        {% if url %}
          <a href="{{ url }}" target="_blank" rel="noopener" class="book-purchase">
            {% faIcon 'arrow-up-right-from-square', 'solid', 16 %}
            Comprar
          </a>
        {% endif %}
      </div>
    </div>
  </header>

  <div class="prose book-review">
    {{ content | safe }}
  </div>
</article>
