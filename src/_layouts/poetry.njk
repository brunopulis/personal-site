---
layout: base
---

<a href="/poetry/" class="cluster" style="--gutter: var(--space-2xs)">
  {% faIcon 'arrow-left', 'solid', '1em' %} Poesias
</a>

<nav class="region" style="--region-space: var(--space-s)" aria-label="Breadcrumb">
  <ol class="cluster" role="list" style="--gutter: var(--space-2xs)">
    <li><a href="/">Home</a></li>
    <li>{% faIcon 'chevron-right', 'solid', '0.8em' %}</li>
    <li><a href="/poetry/">Poesias</a></li>
    <li>{% faIcon 'chevron-right', 'solid', '0.8em' %}</li>
    <li>{{ title }}</li>
  </ol>
</nav>

<article class="h-entry">
  <header class="flow" style="--flow-space: var(--space-2xs)">
    <h1 class="p-name">{{ title }}</h1>
    <p class="meta">
      <time class="dt-published" datetime="{{ page.date | htmlDateString }}">
        {{ page.date | readableDate }}
      </time>
      <a class="visually-hidden u-url" href="{{ page.url }}">Permalink</a>
    </p>
  </header>
  <div class="e-content prose">{{ content | safe }}</div>
</article>
