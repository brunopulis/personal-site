---
layout: base
---

<a href="/notes/" class="cluster" style="--gutter: var(--space-2xs)">
  <span aria-hidden="true">←</span> Voltar para as notas
</a>

<article class="h-entry region note" style="--region-space: var(--space-l)">
  <h1 class="visually-hidden p-name" data-pagefind-meta="title">
    {{ page.date | readableDate }}
  </h1>

  <header class="flow" style="--flow-space: var(--space-2xs)">
    <p class="note-date">
      <time class="dt-published" datetime="{{ page.date | htmlDateString }}">
        {{ page.date | readableDate }}
      </time>
      <a class="visually-hidden u-url" href="{{ page.url }}">Permalink</a>
    </p>
  </header>

  <div class="e-content prose">
    {{ content | safe }}
  </div>

  {% set tags = (tags or []) | reject('equalto', 'notes') | list %}
  {% if tags %}
    <ul class="cluster note-tags" role="list" style="--gutter: var(--space-2xs)">
      {% for tag in tags %}
        <li><a class="p-category" href="/tags/{{ tag | slug }}/">#{{ tag }}</a></li>
      {% endfor %}
    </ul>
  {% endif %}
</article>
